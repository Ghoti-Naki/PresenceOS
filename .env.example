# Database — Neon PostgreSQL connection string
# Get this from https://console.neon.tech
DATABASE_URL=

# Auth — used to sign and verify JWT tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Admin credentials
# ADMIN_USERNAME: the username you'll use to log into /admin
# ADMIN_PASSWORD_HASH: generate with: npm run hash-password -- yourpassword
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Email — Resend API
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address in notification emails
# Must be a verified domain on Resend (use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=

# The email address that receives contact form submissions
CONTACT_EMAIL_TO=

# Your deployed site URL — used in OG tags and sitemap
# Example: https://yourname.vercel.app  or  https://yourdomain.com
NEXT_PUBLIC_SITE_URL=
